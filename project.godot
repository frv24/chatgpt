; Archivo de configuración del proyecto de Godot.
; Normalmente se edita desde el editor (Proyecto > Configuración del proyecto).

config_version=5

[application]

config/name="Mahjong en Español"
config/description="Aprende Mahjong paso a paso, juega partidas y domina sus reglas en español."
config/version="1.0.1"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://assets/icono/icono_redondo_512.png"
config/quit_on_go_back=false
boot_splash/bg_color=Color(0.7607843, 0.09411765, 0.35686275, 1)
boot_splash/image="res://assets/icono/pantalla_carga.png"
boot_splash/fullsize=true
boot_splash/use_filter=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
